# PostgreSQL AWS RDS - StudioBJ
DB_HOST=your-rds-host.rds.amazonaws.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_SCHEMA=bdstudiobj
DATABASE_URL=postgresql+psycopg://your_db_user:your_db_password@your-rds-host.rds.amazonaws.com:5432/postgres?sslmode=require

# Seguridad JWT
JWT_SECRET_KEY=REEMPLAZAR_POR_SECRETO_SEGURO_64_CHARS
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

# Usuario Admin Inicial
ADMIN_EMAIL=admin@studiobj.cl
ADMIN_PASSWORD=REEMPLAZAR_POR_PASSWORD_SEGURO
ADMIN_NOMBRE=Administrador StudioBJ

# PostgREST
PGRST_DB_URI=postgresql://your_db_user:your_db_password@your-rds-host.rds.amazonaws.com:5432/postgres?sslmode=require
PGRST_DB_SCHEMAS=bdstudiobj
PGRST_DB_ANON_ROLE=web_anon
PGRST_SERVER_PORT=3001
